# ---------- Databaze ----------
# Postgres i ve vyvoji (stejne jako citadela-app). Lokalne napr.
#   docker compose up -d   (lokalni Postgres bez hesla, jen na 127.0.0.1)
# Na produkci (Neon) musi retezec koncit `?sslmode=require`.
DATABASE_URL="postgresql://tichy24@localhost:5432/tichy24"

# ---------- Auth.js (jen administrace) ----------
# Vygenerujte: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Dedikovaný HMAC klíč pro anonymní, časově omezené rate-limit identifikátory.
# Doporučeno v produkci; při prázdné hodnotě se použije AUTH_SECRET.
RATE_LIMIT_SECRET=""

# ---------- Verejna adresa ----------
# Bez lomitka na konci; pouziva se pro canonical, sitemap a JSON-LD.
SITE_URL="http://localhost:3000"

# Dokud neni "1", web posila `noindex` a robots.txt zakazuje vsechno.
# Zapnete az po vyplneni udaju v src/lib/site.ts (viz README, "Pred spustenim").
SHOP_LIVE="0"

# ---------- Scheduled maintenance ----------
# Vygenerujte: openssl rand -base64 32. Vercel posila hodnotu jako Bearer token
# pri dennim behu /api/cron/expire-orders. V produkci musi byt nastavena.
CRON_SECRET=""

# ---------- Transakční e-maily (Resend) ----------
# API klíč a adresa odesílatele na doméně ověřené v Resend.
# Pro SHOP_LIVE=1 jsou obě proměnné povinné.
RESEND_API_KEY=""
EMAIL_FROM="Tichy24 <orders@tichy24.ch>"

# ---------- Administrace (seed) ----------
ADMIN_EMAIL="admin@tichy24.ch"
ADMIN_PASSWORD="zmente-me-pred-nasazenim"

# ---------- Platba predem ----------
# Platba predem: SHOP_IBAN musi byt vyplneny pri SHOP_LIVE=1.
SHOP_IBAN=""
SHOP_BANK_HOLDER="Dušan Tichý"

# ---------- Kontaktni udaje (Impressum, Kontakt, AGB, Datenschutz) ----------
# Verejne repo => udaje NEJSOU v kodu. Vyplnte tady (lokalne) a ve Vercelu /
# GitHub Actions variables. Prazdne = na strankach se nezobrazi; s SHOP_LIVE=1
# a prazdnymi povinnymi (PHONE, STREET, POSTAL_CODE, CITY, UID) build selze.
SHOP_EMAIL="info@tichy24.ch"
SHOP_PHONE=""
SHOP_STREET=""
SHOP_POSTAL_CODE=""
SHOP_CITY=""
# Unternehmens-Identifikationsnummer: CHE-123.456.789
SHOP_UID=""
SHOP_PICKUP_HOURS="nach Vereinbarung"

# ---------- Staticka stranka na GitHub Pages ----------
# 1 = povolit indexaci vyhledavaci; vychozi je noindex.
PAGES_INDEX="0"

# Verejne ID ElevenLabs agenta pro hlasoveho asistenta (neni tajne)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_3301m4y78hfse2ksm41yrgjdahp4
