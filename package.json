{
  "name": "tichy24-shop",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cypress run --e2e",
    "cypress:open": "cypress open",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "check:stock": "tsx --conditions=react-server scripts/check-stock-race.mts",
    "check:rate-limit": "tsx --conditions=react-server scripts/check-rate-limit.mts",
    "setup:vercel": "tsx scripts/setup-vercel.ts",
    "build:pages": "tsx scripts/build-pages.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.2",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^7.9.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
